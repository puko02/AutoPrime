            "reconciling": false,
            "template": [
              {
                "annotations": {},
                "labels": {},
                "parallelism": 0,
                "task_count": 1,
                "template": [
                  {
                    "containers": [
                      {
                        "args": [
                          "set -e\r\nDATE=$(date +%Y-%m-%d)\r\nDUMP_FILE=\"/tmp/backup-${DATE}-daily.sql.gz\"\r\n\r\necho \"Iniciando dump do banco ${DB_NAME}...\"\r\nmysqldump \\\r\n  -h \"${DB_HOST}\" \\\r\n  -u \"${DB_USER}\" \\\r\n  -p\"${DB_PASSWORD}\" \\\r\n  --single-transaction \\\r\n  --routines \\\r\n  --triggers \\\r\n  \"${DB_NAME}\" | gzip \u003e \"${DUMP_FILE}\"\r\n\r\necho \"Enviando para o bucket...\"\r\ngsutil cp \"${DUMP_FILE}\" \"gs://project-software-enginnering-autoprime-db-backup/daily/\"\r\n\r\necho \"Backup concluido: ${DUMP_FILE}\"\r\n"
                        ],
                        "command": [
                          "/bin/bash",
                          "-c"
                        ],
                        "env": [
                          {
                            "name": "DB_HOST",
                            "value": "10.0.2.0/24",
                            "value_source": []
                          },
                          {
                            "name": "DB_NAME",
                            "value": "auto_prime",
                            "value_source": []
                          },
                          {
                            "name": "DB_USER",
                            "value": "root",
                            "value_source": []
                          },
                          {
                            "name": "DB_PASSWORD",
                            "value": "",
                            "value_source": []
                          }
                        ],
                        "image": "gcr.io/google.com/cloudsdktool/cloud-sdk:slim",
                        "name": "",
                        "ports": [],
                        "resources": [
                          {
                            "limits": {
                              "cpu": "1",
                              "memory": "512Mi"
                            }
                          }
                        ],
                        "volume_mounts": [],
                        "working_dir": ""
                      }
                    ],
                    "encryption_key": "",
                    "execution_environment": "EXECUTION_ENVIRONMENT_GEN2",
                    "max_retries": 3,
